[Unit]
Description=Centizen eSSL Biometric Attendance Management System
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/firewall/project/essl-attendance-dashboard
ExecStart=/home/firewall/project/essl-attendance-dashboard/venv/bin/python run.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=essl-attendance

[Install]
WantedBy=multi-user.target
